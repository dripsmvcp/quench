# E2E test model configuration
# Set these to run full end-to-end tests with real models.
# Tests are skipped if the model file doesn't exist.

# Primary test model: the model under test for model-agnostic E2E gates
# (prefix cache, greedy locks, engine relaunch, API generate, ...).
QUENCH_TEST_MODEL=/models/Qwen3-4B-Instruct-2507-Q8_0.gguf

# Chunked-prefill equivalence suite (teacher-forced PPL chunk=0 vs chunk>0;
# greedy byte-equality is not asserted — cross-kernel-path ULP noise
# flips greedy argmax depending on the exact quant file). Separate from
# QUENCH_TEST_MODEL so suite runs with a different model under test don't
# hijack these probes.
QUENCH_TEST_MODEL_QWEN4B=/models/Qwen3-4B-Instruct-2507-Q8_0.gguf

# Secondary test model: GDN hybrid architecture (Qwen3.5 Gated DeltaNet)
QUENCH_TEST_MODEL_GDN=/models/Qwen3.5-4B-Q8_0.gguf

# Deterministic-mode E2E proof (DetEvalE2ETest): MoE/hybrid model
QUENCH_TEST_MOE_MODEL=/models/Qwen3.6-35B-A3B-NVFP4
